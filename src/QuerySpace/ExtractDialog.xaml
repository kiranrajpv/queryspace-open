<Window x:Class="QuerySpace.ExtractDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Extract Base Query" Height="620" Width="820" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Start extraction" Click="Start_Click" Style="{StaticResource DialogActionButtonStyle}" MinWidth="120"/>
            <Button Content="Cancel" Click="Cancel_Click" Style="{StaticResource DialogActionButtonStyle}"/>
        </StackPanel>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Text="Connection" Grid.Row="0" Style="{StaticResource FormLabelStyle}"/><ComboBox x:Name="ConnectionBox" Grid.Row="0" Grid.Column="1" DisplayMemberPath="Name" Style="{StaticResource FormComboBoxStyle}"/>
            <TextBlock Text="Dataset name" Grid.Row="1" Style="{StaticResource FormLabelStyle}"/><TextBox x:Name="DatasetNameText" Grid.Row="1" Grid.Column="1" Style="{StaticResource FormTextBoxStyle}"/>
            <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,3,0,9">
                <TextBlock Text="Batch size" VerticalAlignment="Center"/>
                <TextBox x:Name="BatchSizeText" Text="50000" Width="90" Margin="8,0,18,0"/>
                <TextBlock Text="Expected rows" VerticalAlignment="Center"/>
                <TextBox x:Name="ExpectedRowsText" Width="120" Margin="8,0,0,0"/>
            </StackPanel>
            <TextBlock Text="Base query" Grid.Row="3" Style="{StaticResource FormLabelStyle}"/>
            <TextBox x:Name="SqlText" Grid.Row="3" Grid.Column="1" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
        </Grid>
    </DockPanel>
</Window>
