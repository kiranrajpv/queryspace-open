<Window x:Class="QuerySpace.QualityDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Data quality" Height="520" Width="760" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBlock x:Name="SummaryText" FontSize="18"/>
        </StackPanel>
        <DataGrid x:Name="ColumnsGrid"/>
    </DockPanel>
</Window>
