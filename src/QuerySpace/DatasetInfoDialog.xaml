<Window x:Class="QuerySpace.DatasetInfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dataset information" Height="560" Width="820" WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock x:Name="TitleText" FontSize="20"/>
            <TextBlock x:Name="PathText" TextWrapping="Wrap"/>
            <TextBlock x:Name="StatsText"/>
        </StackPanel>
        <DataGrid x:Name="ColumnsGrid"/>
    </DockPanel>
</Window>
