<Window x:Class="QuerySpace.CompareMaterialsResultDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mandatory material comparison results" Height="720" Width="1050" MinHeight="620" MinWidth="860"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="12">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Close" IsDefault="True" Style="{StaticResource DialogActionButtonStyle}" Click="Close_Click"/>
        </StackPanel>

        <TextBlock x:Name="SummaryText" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,10"/>

        <TabControl>
            <TabItem Header="Missing Mandatory Materials">
                <DataGrid x:Name="MissingGrid" IsReadOnly="True"/>
            </TabItem>
            <TabItem Header="Coverage">
                <DataGrid x:Name="CoverageGrid" IsReadOnly="True"/>
            </TabItem>
            <TabItem Header="Reason Summary">
                <DataGrid x:Name="ReasonGrid" IsReadOnly="True"/>
            </TabItem>
            <TabItem Header="Column Impact">
                <DataGrid x:Name="ImpactGrid" IsReadOnly="True"/>
            </TabItem>
            <TabItem Header="SQL Used">
                <TextBox x:Name="SqlText" FontFamily="Consolas" FontSize="14" AcceptsReturn="True" AcceptsTab="True"
                         IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
