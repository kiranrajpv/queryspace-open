<Window x:Class="QuerySpace.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="QuerySpace" Height="820" Width="1280" MinHeight="680" MinWidth="980">
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Padding="8,6"
                BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                BorderThickness="0,0,0,1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Click="SetWorkspace_Click" Style="{StaticResource ToolbarButtonStyle}" MinWidth="44" ToolTip="Set Workspace" AutomationProperties.Name="Set Workspace">
                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#F2B134"/>
                </Button>
                <Button Click="Import_Click" Style="{StaticResource ToolbarButtonStyle}" MinWidth="44" ToolTip="Import CSV/Excel/Parquet" AutomationProperties.Name="Import CSV/Excel/Parquet">
                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#23965F"/>
                </Button>
                <Button Click="AddConnection_Click" Style="{StaticResource ToolbarButtonStyle}" MinWidth="44" ToolTip="Add Connection" AutomationProperties.Name="Add Connection">
                    <TextBlock Text="&#xE839;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#00788C"/>
                </Button>
                <Button Click="Extract_Click" Style="{StaticResource ToolbarButtonStyle}" MinWidth="44" ToolTip="Extract Base Query" AutomationProperties.Name="Extract Base Query">
                    <TextBlock Text="&#xE8D4;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#744DA9"/>
                </Button>
                <Button x:Name="StopExtractButton" Visibility="Collapsed" Click="StopExtraction_Click" Style="{StaticResource ToolbarButtonStyle}" MinWidth="44" ToolTip="Stop Extraction" AutomationProperties.Name="Stop Extraction">
                    <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#C62828"/>
                </Button>
                <Separator Width="12" Opacity="0"/>
                <Button Click="NewQuery_Click" Style="{StaticResource ToolbarButtonStyle}" MinWidth="44" ToolTip="New Query" AutomationProperties.Name="New Query">
                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#0078D4"/>
                </Button>
                <Button Click="SaveSql_Click" Style="{StaticResource ToolbarButtonStyle}" MinWidth="44" ToolTip="Save SQL" AutomationProperties.Name="Save SQL">
                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#2B77D2"/>
                </Button>
                <Button Click="SaveSqlAs_Click" Style="{StaticResource ToolbarButtonStyle}" MinWidth="44" ToolTip="Save SQL As" AutomationProperties.Name="Save SQL As">
                    <TextBlock Text="&#xE792;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#2B77D2"/>
                </Button>
                <Button Click="ExportResult_Click" Style="{StaticResource ToolbarButtonStyle}" MinWidth="44" ToolTip="Export Result" AutomationProperties.Name="Export Result">
                    <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#23965F"/>
                </Button>
                <Button Click="AnalyzeQuality_Click" Style="{StaticResource ToolbarButtonStyle}" MinWidth="44" ToolTip="Analyze Quality" AutomationProperties.Name="Analyze Quality">
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#744DA9"/>
                </Button>
                <Button Click="AnalyzeTransform_Click" Style="{StaticResource ToolbarButtonStyle}" MinWidth="44" ToolTip="Analyze Transform" AutomationProperties.Name="Analyze Transform">
                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#744DA9"/>
                </Button>
                <Separator Width="12" Opacity="0"/>
                <Button x:Name="AiAssistantButton" Click="OpenAiAssistant_Click" Style="{StaticResource ToolbarButtonStyle}" MinWidth="44" ToolTip="Show QuerySpace Assistant" AutomationProperties.Name="Show QuerySpace Assistant">
                    <TextBlock Text="&#xE8BD;" FontFamily="Segoe MDL2 Assets" FontSize="17"/>
                </Button>
                <Button Click="OpenAiSettings_Click" Style="{StaticResource ToolbarButtonStyle}" MinWidth="44" ToolTip="AI and MCP Settings" AutomationProperties.Name="AI and MCP Settings">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="17"/>
                </Button>
            </StackPanel>
            </ScrollViewer>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" HorizontalContentAlignment="Stretch">
            <StatusBarItem HorizontalContentAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <TextBlock x:Name="StatusText" Text="Ready" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <ProgressBar x:Name="ExtractProgressBar" Width="140" Height="12" Margin="10,0,0,0" Minimum="0" Maximum="100" Visibility="Collapsed"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="DuckDB" Margin="12,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" x:Name="UsageStatusText" Text="Memory" Margin="12,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="3" x:Name="RowCountStatusText" Text="0 rows" Margin="12,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="4" x:Name="AiRuntimeStatusText" Text="AI: ready" Margin="12,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="5" x:Name="WorkspaceText" Text="Workspace: app storage" Margin="12,0,4,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
                </Grid>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="46"/>
                <ColumnDefinition Width="284" MinWidth="220"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="480"/>
                <ColumnDefinition x:Name="AiAssistantSplitterColumn" Width="0"/>
                <ColumnDefinition x:Name="AiAssistantColumn" Width="0"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                    BorderThickness="0,0,1,0"
                    Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}">
                <StackPanel>
                    <Button Tag="0" ToolTip="Local Datasets" Click="ExplorerActivity_Click" Style="{StaticResource ToolbarButtonStyle}"
                            MinWidth="40" Width="40" Height="40"
                            Background="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"
                            Foreground="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}">
                        <TextBlock Text="&#xE958;" FontFamily="Segoe MDL2 Assets" FontSize="17"/>
                    </Button>
                    <Button Tag="1" ToolTip="SQL Scripts" Click="ExplorerActivity_Click" Style="{StaticResource ToolbarButtonStyle}" MinWidth="40" Width="40" Height="40">
                        <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="17"/>
                    </Button>
                    <Button Tag="2" ToolTip="Templates" Click="ExplorerActivity_Click" Style="{StaticResource ToolbarButtonStyle}" MinWidth="40" Width="40" Height="40">
                        <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="17"/>
                    </Button>
                    <Button Tag="3" ToolTip="Connections" Click="ExplorerActivity_Click" Style="{StaticResource ToolbarButtonStyle}" MinWidth="40" Width="40" Height="40">
                        <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="17"/>
                    </Button>
                    <Button Tag="4" ToolTip="In-Memory Objects" Click="ExplorerActivity_Click" Style="{StaticResource ToolbarButtonStyle}" MinWidth="40" Width="40" Height="40">
                        <TextBlock Text="&#xE7C2;" FontFamily="Segoe MDL2 Assets" FontSize="17"/>
                    </Button>
                </StackPanel>
            </Border>
            <DockPanel Grid.Column="1">
                <Border DockPanel.Dock="Top" Padding="10,7"
                        BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                        BorderThickness="0,0,0,1">
                    <TextBlock x:Name="ExplorerSectionTitle" Text="LOCAL DATASETS" FontSize="12" FontWeight="SemiBold"/>
                </Border>
                <Border DockPanel.Dock="Top"
                        Margin="4,4,4,6"
                        MinHeight="30"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                        Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="&#xE721;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="15"
                               VerticalAlignment="Center"
                               Margin="8,0,6,0"
                               Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                    <Button x:Name="ClearExplorerSearchButton"
                            Content="×"
                            Grid.Column="2"
                            MinWidth="28"
                            MinHeight="28"
                            Margin="4,0,2,0"
                            BorderThickness="0"
                            Background="Transparent"
                            ToolTip="Clear search"
                            Click="ClearExplorerSearch_Click"/>
                    <TextBox x:Name="ExplorerSearchText"
                             Grid.Column="1"
                             MinHeight="28"
                             BorderThickness="0"
                             Background="Transparent"
                             VerticalContentAlignment="Center"
                             Padding="0,2"
                             ToolTip="Search objects across all explorer tabs"
                             TextChanged="ExplorerSearchText_TextChanged"/>
                    </Grid>
                </Border>
                <TabControl x:Name="ExplorerTabs" BorderThickness="0">
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <ContentPresenter Content="{TemplateBinding SelectedContent}" ContentTemplate="{TemplateBinding SelectedContentTemplate}"/>
                        </ControlTemplate>
                    </TabControl.Template>
                    <TabItem Header="Local Datasets">
                        <TreeView x:Name="DatasetsTree"
                                  PreviewMouseLeftButtonDown="DatasetsTree_PreviewMouseLeftButtonDown"
                                  PreviewMouseRightButtonDown="DatasetsTree_PreviewMouseRightButtonDown"
                                  PreviewMouseMove="DatasetsTree_PreviewMouseMove"
                                  MouseDoubleClick="DatasetsTree_DoubleClick">
                        <TreeView.ContextMenu>
                            <ContextMenu Opened="DatasetContextMenu_Opened">
                                <MenuItem Header="Information" Click="DatasetInfo_Click"/>
                                <MenuItem x:Name="DatasetMcpMenuItem" Header="Available to MCP / AI" IsCheckable="True" Click="DatasetMcpAccess_Click"/>
                                <Separator/>
                                <MenuItem Header="Rename" Click="RenameDataset_Click"/>
                                <MenuItem Header="Delete" Click="DeleteDataset_Click"/>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                        </TreeView>
                    </TabItem>
                    <TabItem Header="SQL Scripts">
                        <TreeView x:Name="ScriptsTree" MouseDoubleClick="ScriptsTree_DoubleClick">
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Rename" Click="RenameScript_Click"/>
                                <MenuItem Header="Delete" Click="DeleteScript_Click"/>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                        </TreeView>
                    </TabItem>
                    <TabItem Header="Templates">
                        <TreeView x:Name="TemplatesTree" MouseDoubleClick="TemplatesTree_DoubleClick"/>
                    </TabItem>
                    <TabItem Header="Connections">
                        <TreeView x:Name="ConnectionsTree"
                                  PreviewMouseLeftButtonDown="ConnectionsTree_PreviewMouseButtonDown"
                                  PreviewMouseRightButtonDown="ConnectionsTree_PreviewMouseButtonDown"
                                  MouseDoubleClick="ConnectionsTree_DoubleClick">
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Edit connection / Open extract query" Click="ConnectionOpen_Click"/>
                                <MenuItem Header="Delete connection / query" Click="ConnectionDelete_Click"/>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                        </TreeView>
                    </TabItem>
                    <TabItem Header="In-Memory">
                        <DockPanel>
                        <TextBlock DockPanel.Dock="Top"
                                   Text="Session-only DuckDB objects. Export important tables before closing QuerySpace."
                                   TextWrapping="Wrap"
                                   Margin="6"
                                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                        <TreeView x:Name="MemoryTree" MouseDoubleClick="MemoryTree_DoubleClick">
                            <TreeView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Preview" Click="MemoryPreview_Click"/>
                                    <MenuItem Header="Information / Schema" Click="MemoryInfo_Click"/>
                                    <MenuItem Header="Generate SELECT" Click="MemoryGenerateSelect_Click"/>
                                    <MenuItem Header="Export" Click="MemoryExport_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Drop Object" Click="MemoryDrop_Click"/>
                                    <Separator/>
                                    <MenuItem Header="Refresh" Click="MemoryRefresh_Click"/>
                                </ContextMenu>
                            </TreeView.ContextMenu>
                            </TreeView>
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </DockPanel>
            <GridSplitter Grid.Column="2" Width="5" HorizontalAlignment="Stretch"/>
            <Grid Grid.Column="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*" MinHeight="180"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="3*" MinHeight="220"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Padding="10,7" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="0,0,0,1">
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="QUERY" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,18,0"/>
                        <Button Click="RunSql_Click" DockPanel.Dock="Left" Style="{StaticResource PrimaryToolbarButtonStyle}" Margin="0,0,14,0" MinWidth="44" ToolTip="Run SQL" AutomationProperties.Name="Run SQL">
                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#23965F"/>
                        </Button>
                        <TextBlock Text="Use:" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,6,0"/>
                        <ComboBox x:Name="UsageCombo" Width="130" MinHeight="32" SelectedIndex="0" DockPanel.Dock="Left" Margin="0,0,18,0" SelectionChanged="UsageCombo_SelectionChanged">
                            <ComboBoxItem>Memory</ComboBoxItem>
                            <ComboBoxItem>Read Only</ComboBoxItem>
                        </ComboBox>
                        <TextBlock Text="Preview rows:" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,6,0"/>
                        <TextBox x:Name="PreviewRowsText" Width="96" MinWidth="96" MinHeight="32" Text="1000" VerticalContentAlignment="Center" DockPanel.Dock="Left" Padding="4,2"/>
                        <TextBlock x:Name="EditorFileText"
                                   Text="Editing: Unsaved query"
                                   VerticalAlignment="Center"
                                   DockPanel.Dock="Left"
                                   Margin="18,0,0,0"
                                   Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="340"/>
                    </DockPanel>
                </Border>
                <TabControl x:Name="QueryTabs"
                            Grid.Row="1"
                            Margin="0,0,0,4"
                            SelectionChanged="QueryTabs_SelectionChanged"/>
                <Border Grid.Row="2" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="1">
                    <avalonedit:TextEditor x:Name="SqlEditor"
                                            FontFamily="Cascadia Code,Consolas"
                                            FontSize="14"
                                            ShowLineNumbers="True"
                                            VerticalScrollBarVisibility="Auto"
                                            HorizontalScrollBarVisibility="Auto"
                                            AllowDrop="True"
                                            PreviewDragOver="SqlEditor_PreviewDragOver"
                                            PreviewDrop="SqlEditor_PreviewDrop"
                                            Text="select * from dataset_name limit 100;"/>
                </Border>
                <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch"/>
                <TabControl x:Name="OutputTabs" Grid.Row="4" ItemContainerStyle="{StaticResource OutputTabItemStyle}">
                    <TabItem Header="Results" ToolTip="Query results">
                        <DataGrid x:Name="ResultsGrid" AutoGenerateColumns="True" IsReadOnly="True" EnableRowVirtualization="True" EnableColumnVirtualization="True"/>
                    </TabItem>
                    <TabItem Header="Messages" ToolTip="Application messages">
                        <ListBox x:Name="MessagesList" FontFamily="Consolas" FontSize="12"/>
                    </TabItem>
                    <TabItem Header="Queue" ToolTip="SQL script execution queue">
                        <ListBox x:Name="ExecutionQueueList" FontFamily="Consolas" FontSize="12"/>
                    </TabItem>
                    <TabItem Header="MCP" ToolTip="MCP and AI tool activity">
                        <ListBox x:Name="McpActivityList" FontFamily="Consolas" FontSize="12"/>
                    </TabItem>
                    <TabItem Header="Quality" ToolTip="Data quality analysis">
                        <StackPanel Margin="12" HorizontalAlignment="Left">
                            <TextBlock Text="Analyze the current result set for completeness, uniqueness and numeric outliers." TextWrapping="Wrap" Margin="0,0,0,10"/>
                            <Button Content="Analyze Current Results" Click="AnalyzeQuality_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Grid>
            <GridSplitter x:Name="AiAssistantSplitter"
                          Grid.Column="4"
                          Width="5"
                          HorizontalAlignment="Stretch"
                          Visibility="Collapsed"/>
            <Border x:Name="AiAssistantPanelBorder"
                    Grid.Column="5"
                    MinWidth="320"
                    BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                    BorderThickness="1,0,0,0"
                    Background="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"
                    Visibility="Collapsed">
                <ContentControl x:Name="AiAssistantHost"/>
            </Border>
        </Grid>
    </DockPanel>
</Window>
