<Window x:Class="QuerySpace.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuerySpace" Height="820" Width="1280" MinHeight="680" MinWidth="980">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="10,8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Set Workspace" Click="SetWorkspace_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                <Button Content="Import CSV/Excel/Parquet" Click="Import_Click" Style="{StaticResource ToolbarButtonStyle}" MinWidth="180"/>
                <Button Content="Add Connection" Click="AddConnection_Click" Style="{StaticResource ToolbarButtonStyle}" MinWidth="130"/>
                <Button Content="Extract Base Query" Click="Extract_Click" Style="{StaticResource ToolbarButtonStyle}" MinWidth="150"/>
                <Button x:Name="StopExtractButton" Content="Stop Extraction" Visibility="Collapsed" Click="StopExtraction_Click" Style="{StaticResource ToolbarButtonStyle}" MinWidth="130"/>
                <Separator Width="12" Opacity="0"/>
                <Button Content="Save SQL" Click="SaveSql_Click" Style="{StaticResource ToolbarButtonStyle}"/>
                <Button Content="Export Results CSV" Click="ExportCsv_Click" Style="{StaticResource ToolbarButtonStyle}" MinWidth="150"/>
                <Button Content="Analyze Quality" Click="AnalyzeQuality_Click" Style="{StaticResource ToolbarButtonStyle}" MinWidth="130"/>
            </StackPanel>
            </ScrollViewer>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready"/>
            </StatusBarItem>
            <StatusBarItem>
                <ProgressBar x:Name="ExtractProgressBar" Width="160" Height="16" Minimum="0" Maximum="100" Visibility="Collapsed"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="WorkspaceText" Text="Workspace: app storage"/>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" MinWidth="240"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="480"/>
            </Grid.ColumnDefinitions>
            <TabControl x:Name="ExplorerTabs" Grid.Column="0">
                <TabItem Header="Local Datasets">
                    <TreeView x:Name="DatasetsTree" MouseDoubleClick="DatasetsTree_DoubleClick">
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Information" Click="DatasetInfo_Click"/>
                                <MenuItem Header="Rename" Click="RenameDataset_Click"/>
                                <MenuItem Header="Delete" Click="DeleteDataset_Click"/>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>
                </TabItem>
                <TabItem Header="SQL Scripts">
                    <TreeView x:Name="ScriptsTree" MouseDoubleClick="ScriptsTree_DoubleClick">
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Rename" Click="RenameScript_Click"/>
                                <MenuItem Header="Delete" Click="DeleteScript_Click"/>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>
                </TabItem>
                <TabItem Header="Connections">
                    <TreeView x:Name="ConnectionsTree" MouseDoubleClick="ConnectionsTree_DoubleClick">
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Edit connection / Open extract query" Click="ConnectionOpen_Click"/>
                                <MenuItem Header="Delete connection / query" Click="ConnectionDelete_Click"/>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>
                </TabItem>
            </TabControl>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*" MinHeight="180"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="3*" MinHeight="220"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Padding="10,8">
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="Query" FontWeight="SemiBold" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,18,0"/>
                        <Button Content="Run SQL" Click="RunSql_Click" DockPanel.Dock="Left" Style="{StaticResource PrimaryToolbarButtonStyle}" Margin="0,0,14,0"/>
                        <TextBlock Text="Use:" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,6,0"/>
                        <ComboBox x:Name="UsageCombo" Width="130" MinHeight="32" SelectedIndex="0" DockPanel.Dock="Left" Margin="0,0,18,0">
                            <ComboBoxItem>Memory</ComboBoxItem>
                            <ComboBoxItem>Read Only</ComboBoxItem>
                        </ComboBox>
                        <TextBlock Text="Preview rows:" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,6,0"/>
                        <TextBox x:Name="PreviewRowsText" Width="96" MinWidth="96" MinHeight="32" Text="1000" VerticalContentAlignment="Center" DockPanel.Dock="Left" Padding="4,2"/>
                    </DockPanel>
                </Border>
                <TextBox x:Name="SqlEditor"
                         Grid.Row="1"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         FontFamily="Consolas"
                         FontSize="15"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Text="select * from dataset_name limit 100;"/>
                <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch"/>
                <DataGrid x:Name="ResultsGrid" Grid.Row="3"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
