<Window x:Class="QuerySpace.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="QuerySpace" Height="820" Width="1280" MinHeight="680" MinWidth="980">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="10,8">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Click="SetWorkspace_Click" Style="{StaticResource ToolbarButtonStyle}" MinWidth="44" ToolTip="Set Workspace" AutomationProperties.Name="Set Workspace">
                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#F2B134"/>
                </Button>
                <Button Click="Import_Click" Style="{StaticResource ToolbarButtonStyle}" MinWidth="44" ToolTip="Import CSV/Excel/Parquet" AutomationProperties.Name="Import CSV/Excel/Parquet">
                    <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#23965F"/>
                </Button>
                <Button Click="AddConnection_Click" Style="{StaticResource ToolbarButtonStyle}" MinWidth="44" ToolTip="Add Connection" AutomationProperties.Name="Add Connection">
                    <TextBlock Text="&#xE839;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#00788C"/>
                </Button>
                <Button Click="Extract_Click" Style="{StaticResource ToolbarButtonStyle}" MinWidth="44" ToolTip="Extract Base Query" AutomationProperties.Name="Extract Base Query">
                    <TextBlock Text="&#xE8D4;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#744DA9"/>
                </Button>
                <Button x:Name="StopExtractButton" Visibility="Collapsed" Click="StopExtraction_Click" Style="{StaticResource ToolbarButtonStyle}" MinWidth="44" ToolTip="Stop Extraction" AutomationProperties.Name="Stop Extraction">
                    <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#C62828"/>
                </Button>
                <Separator Width="12" Opacity="0"/>
                <Button Click="SaveSql_Click" Style="{StaticResource ToolbarButtonStyle}" MinWidth="44" ToolTip="Save SQL" AutomationProperties.Name="Save SQL">
                    <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#2B77D2"/>
                </Button>
                <Button Click="ExportResult_Click" Style="{StaticResource ToolbarButtonStyle}" MinWidth="44" ToolTip="Export Result" AutomationProperties.Name="Export Result">
                    <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#23965F"/>
                </Button>
                <Button Click="AnalyzeQuality_Click" Style="{StaticResource ToolbarButtonStyle}" MinWidth="44" ToolTip="Analyze Quality" AutomationProperties.Name="Analyze Quality">
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#744DA9"/>
                </Button>
                <Button Click="AnalyzeTransform_Click" Style="{StaticResource ToolbarButtonStyle}" MinWidth="44" ToolTip="Analyze Transform" AutomationProperties.Name="Analyze Transform">
                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#744DA9"/>
                </Button>
            </StackPanel>
            </ScrollViewer>
        </Border>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready"/>
            </StatusBarItem>
            <StatusBarItem>
                <ProgressBar x:Name="ExtractProgressBar" Width="160" Height="16" Minimum="0" Maximum="100" Visibility="Collapsed"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="WorkspaceText" Text="Workspace: app storage"/>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330" MinWidth="240"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*" MinWidth="480"/>
            </Grid.ColumnDefinitions>
            <TabControl x:Name="ExplorerTabs" Grid.Column="0">
                <TabItem Header="Local Datasets">
                    <TreeView x:Name="DatasetsTree" MouseDoubleClick="DatasetsTree_DoubleClick">
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Information" Click="DatasetInfo_Click"/>
                                <MenuItem Header="Rename" Click="RenameDataset_Click"/>
                                <MenuItem Header="Delete" Click="DeleteDataset_Click"/>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>
                </TabItem>
                <TabItem Header="SQL Scripts">
                    <TreeView x:Name="ScriptsTree" MouseDoubleClick="ScriptsTree_DoubleClick">
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Rename" Click="RenameScript_Click"/>
                                <MenuItem Header="Delete" Click="DeleteScript_Click"/>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>
                </TabItem>
                <TabItem Header="Templates">
                    <TreeView x:Name="TemplatesTree" MouseDoubleClick="TemplatesTree_DoubleClick"/>
                </TabItem>
                <TabItem Header="Connections">
                    <TreeView x:Name="ConnectionsTree" MouseDoubleClick="ConnectionsTree_DoubleClick">
                        <TreeView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Edit connection / Open extract query" Click="ConnectionOpen_Click"/>
                                <MenuItem Header="Delete connection / query" Click="ConnectionDelete_Click"/>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>
                </TabItem>
            </TabControl>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch"/>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2*" MinHeight="180"/>
                    <RowDefinition Height="5"/>
                    <RowDefinition Height="3*" MinHeight="220"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Padding="10,8">
                    <DockPanel LastChildFill="False">
                        <TextBlock Text="Query" FontWeight="SemiBold" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,18,0"/>
                        <Button Click="RunSql_Click" DockPanel.Dock="Left" Style="{StaticResource PrimaryToolbarButtonStyle}" Margin="0,0,14,0" MinWidth="44" ToolTip="Run SQL" AutomationProperties.Name="Run SQL">
                            <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="#23965F"/>
                        </Button>
                        <TextBlock Text="Use:" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,6,0"/>
                        <ComboBox x:Name="UsageCombo" Width="130" MinHeight="32" SelectedIndex="0" DockPanel.Dock="Left" Margin="0,0,18,0">
                            <ComboBoxItem>Memory</ComboBoxItem>
                            <ComboBoxItem>Read Only</ComboBoxItem>
                        </ComboBox>
                        <TextBlock Text="Preview rows:" VerticalAlignment="Center" DockPanel.Dock="Left" Margin="0,0,6,0"/>
                        <TextBox x:Name="PreviewRowsText" Width="96" MinWidth="96" MinHeight="32" Text="1000" VerticalContentAlignment="Center" DockPanel.Dock="Left" Padding="4,2"/>
                    </DockPanel>
                </Border>
                <TextBox x:Name="SqlEditor"
                         Grid.Row="1"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         FontFamily="Consolas"
                         FontSize="15"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Text="select * from dataset_name limit 100;"/>
                <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch"/>
                <DataGrid x:Name="ResultsGrid" Grid.Row="3"/>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
