<UserControl x:Class="QuerySpace.AiAssistantPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MinWidth="320">
    <DockPanel Margin="10">
        <Border DockPanel.Dock="Top" Padding="0,0,0,10" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Model:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="ModelCombo" Grid.Column="1" MinHeight="30" DisplayMemberPath="DisplayName" SelectionChanged="ModelCombo_SelectionChanged"/>
                <Button Grid.Column="2" Style="{StaticResource DialogActionButtonStyle}" Margin="10,0,0,0" Padding="0" MinWidth="40" MinHeight="40" Width="40" Height="40"
                        ToolTip="Refresh models" AutomationProperties.Name="Refresh models" Click="RefreshModels_Click">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                </Button>
                <Button Grid.Column="3" Style="{StaticResource DialogActionButtonStyle}" Padding="0" MinWidth="40" MinHeight="40" Width="40" Height="40"
                        ToolTip="AI and MCP settings" AutomationProperties.Name="AI and MCP settings" Click="Settings_Click">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                </Button>
                <Button Grid.Column="4" Style="{StaticResource DialogActionButtonStyle}" Padding="0" MinWidth="40" MinHeight="40" Width="40" Height="40"
                        ToolTip="Close assistant" AutomationProperties.Name="Close assistant" Click="Close_Click">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="16"/>
                </Button>
            </Grid>
        </Border>

        <Grid DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="PromptText" Grid.Column="0" MinHeight="70" MaxHeight="150" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" Padding="7" PreviewKeyDown="PromptText_PreviewKeyDown"/>
                <Button x:Name="SendButton" Grid.Column="1" Style="{StaticResource DialogActionButtonStyle}" Padding="0" MinWidth="46" MinHeight="46" Width="46" Height="46"
                        VerticalAlignment="Center" ToolTip="Send prompt (Ctrl+Enter)" AutomationProperties.Name="Send prompt" Click="Send_Click">
                    <TextBlock Text="&#xE724;" FontFamily="Segoe MDL2 Assets" FontSize="19"/>
                </Button>
                <Button x:Name="StopButton" Grid.Column="2" Style="{StaticResource DialogActionButtonStyle}" Padding="0" MinWidth="46" MinHeight="46" Width="46" Height="46"
                        VerticalAlignment="Center" ToolTip="Stop generation" AutomationProperties.Name="Stop generation" IsEnabled="False" Click="Stop_Click">
                    <TextBlock Text="&#xE71A;" FontFamily="Segoe MDL2 Assets" FontSize="18"/>
                </Button>
            </Grid>
            <TextBlock x:Name="HintText" Grid.Row="1" Margin="2,7,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                       Text="Agent tools are restricted by AI Settings and per-dataset MCP access. Ctrl+Enter sends."/>
        </Grid>

        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ListBox x:Name="ConversationList" Grid.Row="0" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="4,5" Padding="10" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="1" CornerRadius="5">
                            <StackPanel>
                                <TextBlock Text="{Binding Role}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="5,8,0,0">
                <ProgressBar x:Name="AgentProgress" Width="90" Height="14" IsIndeterminate="True" Visibility="Collapsed"/>
                <TextBlock x:Name="AgentStatus" Margin="10,0,0,0" VerticalAlignment="Center" Text="Ready"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</UserControl>
